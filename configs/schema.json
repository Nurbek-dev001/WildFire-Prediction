{
  "$defs": {
    "DataConfig": {
      "additionalProperties": false,
      "properties": {
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "object"
        },
        "sealed_detection_archives": {
          "additionalProperties": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sealed Detection Archives",
          "type": "object"
        },
        "weather_mode": {
          "default": "era5_land_cumulative",
          "enum": [
            "daily",
            "era5_land_cumulative",
            "hourly_increment"
          ],
          "title": "Weather Mode",
          "type": "string"
        },
        "historical_roads": {
          "default": false,
          "title": "Historical Roads",
          "type": "boolean"
        },
        "publication_lag_days": {
          "default": 2,
          "minimum": 0,
          "title": "Publication Lag Days",
          "type": "integer"
        },
        "vegetation_fill_days": {
          "default": 32,
          "minimum": 0,
          "title": "Vegetation Fill Days",
          "type": "integer"
        },
        "weather_lag_days": {
          "default": 1,
          "minimum": 0,
          "title": "Weather Lag Days",
          "type": "integer"
        },
        "chunk_rows": {
          "default": 200000,
          "exclusiveMinimum": 0,
          "title": "Chunk Rows",
          "type": "integer"
        },
        "cell_chunk_size": {
          "default": 256,
          "exclusiveMinimum": 0,
          "title": "Cell Chunk Size",
          "type": "integer"
        },
        "maximum_evaluation_rows": {
          "default": 2000000,
          "exclusiveMinimum": 0,
          "title": "Maximum Evaluation Rows",
          "type": "integer"
        }
      },
      "title": "DataConfig",
      "type": "object"
    },
    "EvaluationConfig": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_resamples": {
          "default": 1000,
          "minimum": 1,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_block_days": {
          "default": 30,
          "minimum": 1,
          "title": "Bootstrap Block Days",
          "type": "integer"
        },
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "reliability_bins": {
          "default": 10,
          "minimum": 2,
          "title": "Reliability Bins",
          "type": "integer"
        },
        "top_fractions": {
          "default": [
            0.05,
            0.1,
            0.2
          ],
          "items": {
            "type": "number"
          },
          "title": "Top Fractions",
          "type": "array"
        },
        "map_quantiles": {
          "default": [
            0.5,
            0.8,
            0.95
          ],
          "items": {
            "type": "number"
          },
          "title": "Map Quantiles",
          "type": "array"
        },
        "shap_rows": {
          "default": 500,
          "exclusiveMinimum": 0,
          "title": "Shap Rows",
          "type": "integer"
        }
      },
      "title": "EvaluationConfig",
      "type": "object"
    },
    "EventConfig": {
      "additionalProperties": false,
      "properties": {
        "radius_m": {
          "default": 2000,
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
        },
        "window_hours": {
          "default": 48,
          "exclusiveMinimum": 0.0,
          "title": "Window Hours",
          "type": "number"
        },
        "exclusion_hours": {
          "default": 48,
          "exclusiveMinimum": 0.0,
          "title": "Exclusion Hours",
          "type": "number"
        },
        "sensitivity_radius_m": {
          "default": [
            1000,
            2000,
            3000,
            4000,
            5000
          ],
          "items": {
            "type": "integer"
          },
          "title": "Sensitivity Radius M",
          "type": "array"
        },
        "sensitivity_hours": {
          "default": [
            24,
            48,
            72
          ],
          "items": {
            "type": "integer"
          },
          "title": "Sensitivity Hours",
          "type": "array"
        },
        "hotspot_min_days": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Hotspot Min Days",
          "type": "integer"
        }
      },
      "title": "EventConfig",
      "type": "object"
    },
    "GridConfig": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "default": "+proj=laea +lat_0=48 +lon_0=67 +datum=WGS84 +units=m +no_defs",
          "title": "Crs",
          "type": "string"
        },
        "resolution_m": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "title": "Resolution M",
          "type": "integer"
        },
        "regional_resolution_m": {
          "default": 1000,
          "title": "Regional Resolution M",
          "type": "integer"
        }
      },
      "title": "GridConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "names": {
          "default": [
            "logistic",
            "random_forest",
            "xgboost",
            "catboost"
          ],
          "items": {
            "type": "string"
          },
          "title": "Names",
          "type": "array"
        },
        "trials": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Trials",
          "type": "integer"
        },
        "n_estimators_min": {
          "default": 100,
          "minimum": 2,
          "title": "N Estimators Min",
          "type": "integer"
        },
        "n_estimators_max": {
          "default": 600,
          "minimum": 2,
          "title": "N Estimators Max",
          "type": "integer"
        },
        "early_stopping_rounds": {
          "default": 30,
          "minimum": 1,
          "title": "Early Stopping Rounds",
          "type": "integer"
        },
        "threads": {
          "default": 4,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "seasonal_smoothing": {
          "default": 20,
          "exclusiveMinimum": 0.0,
          "title": "Seasonal Smoothing",
          "type": "number"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    },
    "SamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "probability",
          "enum": [
            "probability",
            "class_weight"
          ],
          "title": "Mode",
          "type": "string"
        },
        "negative_ratio": {
          "default": 10,
          "exclusiveMinimum": 0.0,
          "title": "Negative Ratio",
          "type": "number"
        },
        "minimum_negatives": {
          "default": 20,
          "minimum": 1,
          "title": "Minimum Negatives",
          "type": "integer"
        }
      },
      "title": "SamplingConfig",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "downloaded_at": {
          "title": "Downloaded At",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "path",
        "source_id",
        "version",
        "downloaded_at"
      ],
      "title": "Source",
      "type": "object"
    },
    "SplitConfig": {
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "default": 2015,
          "title": "Start Year",
          "type": "integer"
        },
        "development_end": {
          "default": 2021,
          "title": "Development End",
          "type": "integer"
        },
        "validation_years": {
          "default": [
            2019,
            2020,
            2021
          ],
          "items": {
            "type": "integer"
          },
          "title": "Validation Years",
          "type": "array"
        },
        "calibration_year": {
          "default": 2022,
          "title": "Calibration Year",
          "type": "integer"
        },
        "test_years": {
          "default": [
            2023,
            2024
          ],
          "items": {
            "type": "integer"
          },
          "title": "Test Years",
          "type": "array"
        },
        "spatial_folds": {
          "default": 5,
          "minimum": 2,
          "title": "Spatial Folds",
          "type": "integer"
        },
        "block_m": {
          "default": 100000,
          "exclusiveMinimum": 0,
          "title": "Block M",
          "type": "integer"
        },
        "buffer_m": {
          "default": 25000,
          "minimum": 25000,
          "title": "Buffer M",
          "type": "integer"
        },
        "sensitivity_block_m": {
          "default": [
            50000,
            150000
          ],
          "items": {
            "type": "integer"
          },
          "title": "Sensitivity Block M",
          "type": "array"
        }
      },
      "title": "SplitConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "output_dir": {
      "default": "..\\runs\\primary",
      "format": "path",
      "title": "Output Dir",
      "type": "string"
    },
    "data": {
      "allOf": [
        {
          "$ref": "#/$defs/DataConfig"
        }
      ],
      "default": {
        "synthetic": false,
        "sources": {},
        "sealed_detection_archives": {},
        "weather_mode": "era5_land_cumulative",
        "historical_roads": false,
        "publication_lag_days": 2,
        "vegetation_fill_days": 32,
        "weather_lag_days": 1,
        "chunk_rows": 200000,
        "cell_chunk_size": 256,
        "maximum_evaluation_rows": 2000000
      }
    },
    "grid": {
      "allOf": [
        {
          "$ref": "#/$defs/GridConfig"
        }
      ],
      "default": {
        "crs": "+proj=laea +lat_0=48 +lon_0=67 +datum=WGS84 +units=m +no_defs",
        "resolution_m": 5000,
        "regional_resolution_m": 1000
      }
    },
    "events": {
      "allOf": [
        {
          "$ref": "#/$defs/EventConfig"
        }
      ],
      "default": {
        "radius_m": 2000.0,
        "window_hours": 48.0,
        "exclusion_hours": 48.0,
        "sensitivity_radius_m": [
          1000,
          2000,
          3000,
          4000,
          5000
        ],
        "sensitivity_hours": [
          24,
          48,
          72
        ],
        "hotspot_min_days": 30
      }
    },
    "sampling": {
      "allOf": [
        {
          "$ref": "#/$defs/SamplingConfig"
        }
      ],
      "default": {
        "mode": "probability",
        "negative_ratio": 10.0,
        "minimum_negatives": 20
      }
    },
    "splits": {
      "allOf": [
        {
          "$ref": "#/$defs/SplitConfig"
        }
      ],
      "default": {
        "start_year": 2015,
        "development_end": 2021,
        "validation_years": [
          2019,
          2020,
          2021
        ],
        "calibration_year": 2022,
        "test_years": [
          2023,
          2024
        ],
        "spatial_folds": 5,
        "block_m": 100000,
        "buffer_m": 25000,
        "sensitivity_block_m": [
          50000,
          150000
        ]
      }
    },
    "models": {
      "allOf": [
        {
          "$ref": "#/$defs/ModelConfig"
        }
      ],
      "default": {
        "names": [
          "logistic",
          "random_forest",
          "xgboost",
          "catboost"
        ],
        "trials": 50,
        "n_estimators_min": 100,
        "n_estimators_max": 600,
        "early_stopping_rounds": 30,
        "threads": 4,
        "seasonal_smoothing": 20.0
      }
    },
    "evaluation": {
      "allOf": [
        {
          "$ref": "#/$defs/EvaluationConfig"
        }
      ],
      "default": {
        "bootstrap_resamples": 1000,
        "bootstrap_block_days": 30,
        "confidence_level": 0.95,
        "reliability_bins": 10,
        "top_fractions": [
          0.05,
          0.1,
          0.2
        ],
        "map_quantiles": [
          0.5,
          0.8,
          0.95
        ],
        "shap_rows": 500
      }
    }
  },
  "title": "Config",
  "type": "object"
}